@startuml
title IOhire - Sprint 2: Candidature publique + GDPR + RH candidates

' Cache tous les cercles par défaut
hide circle
' Réactive le cercle uniquement pour les enums
show enum circle

' Paramètres pour un rendu pur Noir et Blanc
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor white

skinparam class {
    BackgroundColor white
    BorderColor black
    ArrowColor black
}

left to right direction

'======================
' Enums
'======================
enum ApplicationStatus {
    NEW
    PROCESSING
    PROCESSED
    REVIEWING
    SHORTLISTED
    REJECTED
    HIRED
    ERROR
}

enum JobPostingStatus {
    DRAFT
    OPEN
    CLOSED
}

'======================
' Actors
'======================
class Visitor {
}

class HRUser {
    email: String
    password: String
    role: String
    viewCandidates(filters: Object): Candidate[*]
    viewCandidateDetail(id: Integer): Candidate
    updateCandidateStatus(id: Integer, status: ApplicationStatus): Candidate
    updateHRNotes(id: Integer, notes: String): Candidate
    downloadResume(id: Integer): String
}

'======================
' Domain Entities
'======================
class Candidate {
    id: Integer
    fullName: String
    email: String
    linkedIn: String
    portfolio: String
    country: String
    city: String
    resume: String
    status: ApplicationStatus
    publicToken: String
    trackingCodeHash: String
    trackingCodeExpiresAt: String
    consent: Boolean
    consentAt: String
    retentionUntil: String
    hrNotes: String
    candidateNotes: String
    selfReportedYearsExperience: Integer
    submitApplication(data: Object): void
    withdrawApplication(token: String): void
    requestTrackingCode(email: String): void
    verifyTrackingCode(email: String, code: String): Candidate[*]
    updateProfile(data: Object): void
    transitionStatus(newStatus: ApplicationStatus): Boolean
}

class JobPosting {
    id: Integer
    title: String
    description: String
    status: JobPostingStatus
    getCandidates(): Candidate[*]
    getCandidateCount(): Integer
}

'======================
' Value Objects
'======================
class Requirements {
    skillsRequired: String[*]
    skillsNiceToHave: String[*]
    departments: String[*]
    minYearsExperience: Integer
    notes: String
}

'======================
' Services
'======================
class VerificationStore {
    generateCode(email: String): Object
    verifyCode(email: String, code: String): Object
    cleanupExpiredCodes(): void
    isCodeValid(email: String, code: String): Boolean
}

class EmailService {
    sendVerificationCode(to: String, code: String): void
    sendApplicationConfirmation(to: String, jobTitle: String): void
    sendWithdrawalConfirmation(to: String): void
    sendStatusUpdate(to: String, status: ApplicationStatus): void
}

'======================
' Relationships
'======================
Candidate "*" --> "1" JobPosting : applies_to
JobPosting "1" *-- "1" Requirements : contains
Requirements --> "0..*" JobPosting : specifies

HRUser --> "0..*" Candidate : reviews
HRUser --> "0..*" JobPosting : manages

Visitor ..> JobPosting : browses_open
Visitor ..> Candidate : submits/withdraws
Visitor ..> VerificationStore : requests_code

VerificationStore ..> EmailService : sends_via
VerificationStore "1" --> "0..*" Candidate : verifies
@enduml
