@startuml Sprint2_WithdrawApplication_Sequence
!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontColor black
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam padding 10

title Sprint 2: Withdraw Application - MVC Sequence\nPublic Candidate

actor "Candidate" as Candidate
participant "PublicJobsComponent\n(View)" as View
participant "CandidateController\n(Controller)" as Controller
database "Candidate\n(Model)" as Model

== **Withdraw Application Flow** ==

Candidate -> View: Click "Withdraw Application"\nProvide public token
activate View

View -> Controller: POST /api/candidates/withdraw\n{publicToken: "tok_abc123"}
activate Controller

Controller -> Model: SELECT id, status FROM candidates\nWHERE publicToken = 'tok_abc123'
activate Model

alt token invalid or not found
    Model -> Controller: No result
    deactivate Model
    Controller -> View: HTTP 404\n{error: "Invalid token"}
    deactivate Controller
    View -> Candidate: Show error
    stop
end

Model -> Controller: {id: 42, status: "reviewing"}
deactivate Model

Controller -> Model: UPDATE candidates\nSET status = 'withdrawn'\nWHERE id = 42
activate Model
Model -> Controller: Update successful
deactivate Model

Controller -> View: HTTP 200 OK\n{message: "Application withdrawn"}
deactivate Controller

View -> Candidate: ✅ Withdrawal confirmed\nStatus updated
deactivate View

@enduml
