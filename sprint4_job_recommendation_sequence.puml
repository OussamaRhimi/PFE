@startuml Sprint4_JobRecommendation_Sequence
!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontColor black
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam padding 10

title Sprint 4: Job Recommendation Engine - MVC Sequence\nAI Matches Candidate Skills to Jobs

actor "Candidate" as Candidate
participant "JobRecommendationComponent\n(View)" as View
participant "RecommendationController\n(Controller)" as Controller
participant "AI Engine\n(Secondary)" as AI
database "JobPosting\n(Model)" as Model

== **Job Recommendation Flow** ==

Candidate -> View: Upload resume (PDF/DOCX/TXT)\nRequest recommendations
activate View

View -> Controller: POST /api/public/recommendations\nmultipart/form-data\n{file: resume}\nNo auth required (public)
activate Controller

Controller -> Controller: Validate file\n- MIME type (PDF/DOCX/TXT only)\n- File size < 20MB
alt validation fails
    Controller -> View: HTTP 400\n{error: "Invalid file"}
    deactivate Controller
    View -> Candidate: Show error
    stop
end

Controller -> AI: Extract resume text\n(max 18KB)
activate AI
AI -> Controller: {resumeText: "John Doe..."}
deactivate AI

Controller -> Model: SELECT * FROM job_postings\nWHERE status = 'open'\nLIMIT 200
activate Model
Model -> Controller: [{id: 1, title: "React Dev",\nrequirements: {skillsRequired: [...],\nskillsNiceToHave: [...]}}, ...] (max 200)
deactivate Model

Controller -> AI: Score jobs\nExtract candidate skills from resume\nMatch against each job\nCalculate compatibility score
activate AI
AI -> Controller: {skills: ["React", "TypeScript", ...],\ntop: [{id: 1, title: "React Dev",\ncompatibility: 95}, {id: 3, title: "Node Dev",\ncompatibility: 78}, {id: 7, title: "Python Dev",\ncompatibility: 65}]}
deactivate AI

Controller -> View: HTTP 200 OK\n{skills: [...], totalConsidered: 15,\ntop: [{id, title, compatibility,\nmatchedRequired, missingRequired,\nmatchedNiceToHave}]}
deactivate Controller

View -> View: Render recommendations\n- Display top 3 matching jobs\n- Show compatibility score\n- Show matched & missing skills
View -> Candidate: ✅ Your Top 3 Job Matches\n1. React Developer (95% match)\n2. Node.js Developer (78% match)\n3. Python Developer (65% match)\nView Details | Apply Now
deactivate View

@enduml
