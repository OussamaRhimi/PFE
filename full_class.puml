@startuml
title IOhire - Full Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
left to right direction

'======================
' Actors
'======================
class Visitor <<anonymous>>

class HRUser <<Strapi Admin>> {
  +email: string
  +password: string
  +role: string
}

'======================
' Core entities
'======================
class Candidate {
  +id: int
  +fullName: string
  +email: email
  +linkedin: string
  +portfolio: string
  +country: string
  +city: string
  +resume: Media
  +status: ApplicationStatus
  +score: decimal
  +publicToken: string
  +trackingCodeHash: string
  +trackingCodeExpiresAt: datetime
  +consent: boolean
  +consentAt: datetime
  +retentionUntil: datetime
  +hrNotes: text
  +candidateNotes: text
  +selfReportedYearsExperience: int
  +extractedData: json
  +standardizedCvMarkdown: text
  +cvTemplateKey: CvTemplateKey
}

class JobPosting {
  +id: int
  +title: string
  +description: text
  +requirements: Requirements
  +status: JobPostingStatus
}

class Skill {
  +id: int
  +name: string <<unique>>
}

class Department {
  +id: int
  +name: string <<unique>>
}

'======================
' Embedded value objects (JSON)
'======================
class Requirements <<value object>> {
  +skillsRequired: string[*]
  +skillsNiceToHave: string[*]
  +departments: string[*]
  +minYearsExperience: int
  +notes: string
}

class EvaluationConfig <<value object>> {
  +fitWeight: int
  +completenessWeight: int
  +requiredSkillsWeight: int
  +niceToHaveSkillsWeight: int
  +experienceWeight: int
  +completenessPoints: json
  +qualityThresholds: json
  +customCriteria: CustomCriterion[*]
}

class CVTemplate <<catalog>> {
  +key: CvTemplateKey
  +name: string
  +description: string
}

'======================
' Services
'======================
class VerificationStore <<service>> {
  +generateCode(email: string): {code, cooldown}
  +verifyCode(email: string, code: string): {valid, error?}
}

class EmailService <<service>> {
  +sendVerificationCode(to: string, code: string): void
}

class AIProcessor <<service>> {
  +processCandidate(candidateId: int): void
  +extractTextFromResume(resume: Media): string
  +deterministicEvaluate(req, data, meta): EvaluationResult
  +recommendJobPostings(resume: Media): JobRecommendation[*]
}

'======================
' Transient objects
'======================
class JobRecommendation <<transient>> {
  +id: int
  +title: string
  +compatibility: decimal
  +matchedRequired: string[*]
  +missingRequired: string[*]
}

class BulkStatusCommand <<transient>> {
  +ids: int[*]
  +status: ApplicationStatus
}

class AnalyticsSnapshot <<transient>> {
  +totalJobPostings: int
  +totalCandidates: int
  +averageScore: decimal
  +statusDistribution: json
  +scoreHistogram: json
}

class ChatSession <<transient>> {
  +messages: ChatMessage[*]
}

class ChatMessage <<transient>> {
  +role: ChatRole
  +content: string
}

'======================
' Relationships
'======================
Candidate "*" --> "1" JobPosting : applies to >
JobPosting "1" *-- "1" Requirements : contains >
Requirements "0..1" *-- "0..1" EvaluationConfig : configures >
Requirements "0..*" ..> "0..*" Skill : references >
Requirements "0..*" ..> "0..*" Department : references >

HRUser "1" --> "0..*" JobPosting : manages >
HRUser "1" --> "0..*" Candidate : reviews >
HRUser ..> AnalyticsSnapshot : views >
HRUser ..> BulkStatusCommand : issues >
BulkStatusCommand ..> Candidate : updates status >

AnalyticsSnapshot ..> Candidate : aggregates >
AnalyticsSnapshot ..> JobPosting : aggregates >

Visitor ..> JobPosting : browses (open) >
Visitor ..> Candidate : submits / deletes >
Visitor ..> VerificationStore : tracks via email >
Visitor ..> JobRecommendation : requests >
Visitor ..> ChatSession : chats >

VerificationStore ..> EmailService : sends code via >
VerificationStore ..> Candidate : retrieves applications >

ChatSession "1" *-- "1..*" ChatMessage : contains >

Candidate "1" --> "0..1" CVTemplate : uses >
AIProcessor ..> Candidate : processes >
AIProcessor ..> JobPosting : queries >
AIProcessor ..> Requirements : reads >
AIProcessor ..> EvaluationConfig : applies >
AIProcessor ..> CVTemplate : renders with >
AIProcessor ..> JobRecommendation : produces >
AIProcessor ..> ChatSession : responds to >
JobRecommendation "*" --> "1" JobPosting : targets >

'======================
' Enums
'======================
enum ApplicationStatus {
  new
  processing
  processed
  reviewing
  shortlisted
  rejected
  hired
  error
}

enum JobPostingStatus {
  draft
  open
  closed
}

enum ChatRole {
  user
  assistant
}

enum CvTemplateKey {
  standard
  experience_first
  skills_first
  compact
  education_first
  project_focus
  sidebar_photo
  accent_pink
  teal_circle
  navy_gold
  sunset
}

@enduml
