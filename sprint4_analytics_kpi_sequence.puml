@startuml Sprint4_AnalyticsDashboard_KPI_Snapshot_Sequence
!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontColor black
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam padding 10

title Sprint 4: Analytics Dashboard - MVC Sequence\nHR Views KPI Metrics

actor "HR User" as HR
participant "AnalyticsComponent\n(View)" as View
participant "AnalyticsController\n(Controller)" as Controller
participant "CandidateController\n(Controller)" as CandidateController
participant "JobPostingController\n(Controller)" as JobController
database "Candidate\n(Model)" as CandidateModel
database "JobPosting\n(Model)" as JobModel

== **AUTH (Referenced Flow)** ==

group #F0F0F0 AUTH
    HR -> HR: Verify JWT Token\n& role=hr_manager
    activate HR
    note right: See: Sprint1_Authentication_Sequence
    deactivate HR
end

== **Analytics KPI Dashboard** ==

HR -> View: Open Analytics Dashboard
activate View

View -> Controller: GET /api/hr/analytics\nHeaders: Authorization: Bearer {jwt_token}
activate Controller

Controller -> Controller: Validate JWT & role

Controller -> CandidateController: Get candidate KPI aggregates
activate CandidateController

CandidateController -> CandidateModel: COUNT(*) FROM candidates
activate CandidateModel
CandidateModel -> CandidateController: 127
deactivate CandidateModel

CandidateController -> CandidateModel: COUNT(*) FROM candidates GROUP BY status
activate CandidateModel
CandidateModel -> CandidateController: {new: 12, processing: 0, processed: 28,\nreviewing: 8, shortlisted: 3, rejected: 4, hired: 1}
deactivate CandidateModel

CandidateController -> CandidateModel: COUNT(*) FROM candidates GROUP BY score ranges
activate CandidateModel
CandidateModel -> CandidateController: [{0-49: 8}, {50-69: 15}, {70-84: 56}, {85-100: 48}]
deactivate CandidateModel

CandidateController -> CandidateModel: SELECT createdAt FROM candidates\nGROUP BY DATE_TRUNC('month', createdAt)
activate CandidateModel
CandidateModel -> CandidateController: [{2025-11: 15}, {2025-12: 22}, {2026-01: 18},\n{2026-02: 25}, {2026-03: 28}, {2026-04: 19}]
deactivate CandidateModel

CandidateController -> Controller: Candidate KPI aggregates
deactivate CandidateController

Controller -> JobController: Get job posting stats
activate JobController
JobController -> JobModel: COUNT(*) FROM job_postings WHERE status = 'open'
activate JobModel
JobModel -> JobController: {total: 15, open: 7, closed: 8}
deactivate JobModel
JobController -> Controller: Job posting stats
deactivate JobController

Controller -> Controller: Calculate derived metrics\n- Hire rate = (1 / 127) * 100 = 0.79%\n- Review rate = (8+3) / 127 = 8.66%\n- Avg score = 71.5

Controller -> View: HTTP 200 OK\n{summary: {totalCandidates: 127, hireRate: 0.79},\nstatusCounts: {...}, scoreBuckets: {...},\nmonthlyApplications: {...}, jobStats: {...}}
deactivate Controller

View -> View: Render dashboard charts\n- KPI cards, pie chart, bar chart,\nline chart, tables
View -> HR: ✅ Analytics Loaded\nDisplay: 127 Candidates | 0.79% Hired\n| 8.66% In Review | 15 Jobs | 7 Open
deactivate View

@enduml
