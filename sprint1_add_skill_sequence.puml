@startuml Sprint1_AddSkill_Sequence
!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontColor black
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam padding 10

title Sprint 1: Add Skill - MVC Sequence\nAuthenticated HR User

actor "HR User" as HR
participant "SkillsComponent\n(View)" as View
participant "SkillController\n(Controller)" as Controller
database "Skill\n(Model)" as Model

== **AUTH (Referenced Flow)** ==

group #F0F0F0 AUTH
    HR -> HR: Verify JWT Token
    activate HR
    note right: See: Sprint1_Authentication_Sequence
    deactivate HR
end

== **Add Skill Flow** ==

HR -> View: Enter skill name ("Python")\nClick Add button
activate View

View -> Controller: POST /api/skills\n{name: "Python"}
activate Controller

Controller -> Model: SELECT id FROM skills\nWHERE LOWER(name) = LOWER('Python')
activate Model

alt name already exists
    Model -> Controller: {id: 15}
    deactivate Model
    Controller -> View: HTTP 409 Conflict\n{error: "Skill already exists"}
    deactivate Controller
    View -> HR: Show error message
    stop
end

Model -> Controller: No result (unique)
deactivate Model

Controller -> Model: INSERT INTO skills\n(name, created_at, updated_at, created_by)\nVALUES ('Python', NOW(), NOW(), 2)
activate Model

Model -> Controller: {id: 25, name: "Python"}
deactivate Model

Controller -> View: HTTP 201 Created\n{id: 25, name: "Python"}
deactivate Controller

View -> View: Add to skills array\nClear input field
View -> HR: Display in list\nShow success notification
deactivate View

@enduml
