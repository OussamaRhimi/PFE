{
  "kind": "collectionType",
  "collectionName": "job_postings",
  "info": {
    "singularName": "job-posting",
    "pluralName": "job-postings",
    "displayName": "Job Posting"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "required": true
    },
    "description": {
      "type": "text"
    },
    "requirements": {
      "type": "json",
      "required": false
    },
    "status": {
      "type": "enumeration",
      "required": true,
      "default": "draft",
      "enum": [
        "draft",
        "open",
        "closed"
      ]
    },
    "candidate": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::candidate.candidate",
      "mappedBy": "job_posting"
    }
  }
}
