{
  "kind": "collectionType",
  "collectionName": "candidates",
  "info": {
    "singularName": "candidate",
    "pluralName": "candidates",
    "displayName": "Candidate"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "linkedin": {
      "type": "string",
      "maxLength": 300
    },
    "portfolio": {
      "type": "string",
      "maxLength": 300
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "job_posting": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job-posting.job-posting",
      "inversedBy": "candidate",
      "filterable": true
    },
    "status": {
      "type": "enumeration",
      "required": true,
      "default": "new",
      "enum": [
        "new",
        "processing",
        "processed",
        "reviewing",
        "shortlisted",
        "rejected",
        "hired",
        "error"
      ]
    },
    "score": {
      "type": "decimal",
      "default": 0
    },
    "publicToken": {
      "type": "string",
      "unique": true
    },
    "trackingCodeHash": {
      "type": "string",
      "private": true
    },
    "trackingCodeExpiresAt": {
      "type": "datetime",
      "private": true
    },
    "consent": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "consentAt": {
      "type": "datetime"
    },
    "retentionUntil": {
      "type": "datetime"
    },
    "hrNotes": {
      "type": "text"
    },
    "candidateNotes": {
      "type": "text"
    },
    "selfReportedYearsExperience": {
      "type": "integer"
    },
    "extractedData": {
      "type": "json"
    },
    "standardizedCvMarkdown": {
      "type": "text"
    },
    "cvTemplateKey": {
      "type": "enumeration",
      "enum": [
        "standard",
        "experience_first",
        "skills_first",
        "compact",
        "education_first",
        "project_focus",
        "sidebar_photo",
        "accent_pink",
        "teal_circle",
        "navy_gold",
        "sunset"
      ],
      "default": "standard"
    }
  }
}
