@startuml "IOhire - Full Class Diagram"
!define DOMAIN_COLOR #E1F5FF
!define SERVICE_COLOR #FFF3E0
!define VALUE_OBJECT_COLOR #F3E5F5
!define ENUM_COLOR #E8F5E9
!define TRANSIENT_COLOR #FCE4EC
!define ACTOR_COLOR #FFEBEE

skinparam backgroundColor #FAFAFA
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam class {
    BackgroundColor DOMAIN_COLOR
    BorderColor #0277BD
    ArrowColor #01579B
}

left to right direction

'======================
' Enums
'======================
enum ApplicationStatus <<ENUM>> #E8F5E9 {
    NEW
    PROCESSING
    PROCESSED
    REVIEWING
    SHORTLISTED
    REJECTED
    HIRED
    ERROR
}

enum JobPostingStatus <<ENUM>> #E8F5E9 {
    DRAFT
    OPEN
    CLOSED
}

enum CvTemplateKey <<ENUM>> #E8F5E9 {
    STANDARD
    EXPERIENCE_FIRST
    SKILLS_FIRST
    COMPACT
    EDUCATION_FIRST
    PROJECT_FOCUS
    SIDEBAR_PHOTO
    ACCENT_PINK
    TEAL_CIRCLE
    NAVY_GOLD
    SUNSET
}

enum ChatRole <<ENUM>> #E8F5E9 {
    USER
    ASSISTANT
}

'======================
' Standard Types
'======================
class EvaluationResult <<VALUE_OBJECT>> #F3E5F5 {
    -score: Decimal
    -status: ApplicationStatus
    -feedback: String
    -matchedSkills: String[*]
    -missingSkills: String[*]
}

'======================
' Actors
'======================
class Visitor <<ACTOR>> #FFEBEE {
}

class HRUser <<ACTOR>> #FFEBEE {
    -email: String
    -password: String
    -role: String
    +createSkill(name: String): Skill
    +updateSkill(id: Integer, name: String): Skill
    +deleteSkill(id: Integer): void
    +createDepartment(name: String): Department
    +updateDepartment(id: Integer, name: String): Department
    +deleteDepartment(id: Integer): void
    +createJobPosting(data: Object): JobPosting
    +updateJobPosting(id: Integer, data: Object): JobPosting
    +deleteJobPosting(id: Integer): void
    +viewCandidates(filters: Object): Candidate[*]
    +viewCandidateDetail(id: Integer): Candidate
    +updateCandidateStatus(id: Integer, status: ApplicationStatus): Candidate
    +updateHRNotes(id: Integer, notes: String): Candidate
    +downloadResume(id: Integer): String
    +viewAnalytics(): AnalyticsSnapshot
    +configureEvaluation(jobId: Integer, config: EvaluationConfig): void
}

'======================
' Domain Entities
'======================
class Candidate #E1F5FF {
    -id: Integer
    -fullName: String
    -email: String
    -linkedIn: String
    -portfolio: String
    -country: String
    -city: String
    -resume: String
    -status: ApplicationStatus
    -score: Decimal
    -publicToken: String
    -trackingCodeHash: String
    -trackingCodeExpiresAt: String
    -consent: Boolean
    -consentAt: String
    -retentionUntil: String
    -hrNotes: String
    -candidateNotes: String
    -selfReportedYearsExperience: Integer
    -extractedData: Object
    -standardizedCvMarkdown: String
    -cvTemplateKey: CvTemplateKey
    +submitApplication(data: Object): void
    +withdrawApplication(token: String): void
    +requestTrackingCode(email: String): void
    +verifyTrackingCode(email: String, code: String): Candidate[*]
    +updateProfile(data: Object): void
    +transitionStatus(newStatus: ApplicationStatus): Boolean
    +getScore(): Decimal
    +getExtractedData(): Object
    +getStandardizedCV(): String
    +changeCVTemplate(key: CvTemplateKey): void
    +getEvaluationResult(): EvaluationResult
    +getStatus(): ApplicationStatus
    +updateStatus(newStatus: ApplicationStatus): void
}

class JobPosting #E1F5FF {
    -id: Integer
    -title: String
    -description: String
    -status: JobPostingStatus
    +publish(): void
    +close(): void
    +updateRequirements(requirements: Requirements): void
    +getOpenJobs(): JobPosting[*]
    +getCandidates(): Candidate[*]
    +getCandidateCount(): Integer
    +getTitle(): String
    +getRequirements(): Requirements
    +getEvaluationConfig(): EvaluationConfig
}

class Skill #E1F5FF {
    -id: Integer
    -name: String
    +getName(): String
    +validate(): Boolean
}

class Department #E1F5FF {
    -id: Integer
    -name: String
    +getName(): String
    +validate(): Boolean
}

'======================
' Value Objects
'======================
class Requirements <<VALUE_OBJECT>> #F3E5F5 {
    -skillsRequired: String[*]
    -skillsNiceToHave: String[*]
    -departments: String[*]
    -minYearsExperience: Integer
    -notes: String
}

class EvaluationConfig <<VALUE_OBJECT>> #F3E5F5 {
    -fitWeight: Integer
    -completenessWeight: Integer
    -requiredSkillsWeight: Integer
    -niceToHaveSkillsWeight: Integer
    -experienceWeight: Integer
    -completenessPoints: Object
    -qualityThresholds: Object
}

class CVTemplate <<VALUE_OBJECT>> #F3E5F5 {
    -key: CvTemplateKey
    -name: String
    -description: String
}

'======================
' Services
'======================
class VerificationStore <<SERVICE>> #FFF3E0 {
    +generateCode(email: String): Object
    +verifyCode(email: String, code: String): Object
    +cleanupExpiredCodes(): void
    +isCodeValid(email: String, code: String): Boolean
}

class EmailService <<SERVICE>> #FFF3E0 {
    +sendVerificationCode(to: String, code: String): void
    +sendApplicationConfirmation(to: String, jobTitle: String): void
    +sendWithdrawalConfirmation(to: String): void
    +sendStatusUpdate(to: String, status: ApplicationStatus): void
}

class AIProcessor <<SERVICE>> #FFF3E0 {
    +processCandidate(candidateId: Integer): void
    +extractTextFromResume(resume: String): String
    +parseResumeJSON(cvText: String): Object
    +deterministicEvaluate(requirements: Requirements, data: Object, meta: Object): EvaluationResult
    +generateCVMarkdown(data: Object): String
    +renderCVTemplate(templateKey: CvTemplateKey, contact: Object, content: Object): String
    +exportCVtoPDF(html: String): String
    +reprocessCandidate(candidateId: Integer): void
    +getAvailableTemplates(): CVTemplate[*]
    +recommendJobPostings(resume: String): JobRecommendation[*]
    +generateChatResponse(messages: ChatMessage[*]): String
    +evaluateCandidate(candidate: Candidate, config: EvaluationConfig): EvaluationResult
    +filterCandidatesByScore(scoreOp: String, scoreValue: Decimal): Candidate[*]
    +calculateScoreDistribution(): Object
}

'======================
' Transient Objects
'======================
class JobRecommendation <<TRANSIENT>> #FCE4EC {
    +id: Integer
    +title: String
    +compatibility: Decimal
    +matchedRequired: String[*]
    +missingRequired: String[*]
}

class BulkStatusCommand <<TRANSIENT>> #FCE4EC {
    +ids: Integer[*]
    +status: ApplicationStatus
}

class AnalyticsSnapshot <<TRANSIENT>> #FCE4EC {
    +totalJobPostings: Integer
    +totalCandidates: Integer
    +averageScore: Decimal
    +statusDistribution: Object
    +scoreHistogram: Object
}

class ChatSession <<TRANSIENT>> #FCE4EC {
    +id: String
    +messages: ChatMessage[*]
    +addMessage(role: ChatRole, content: String): void
    +getMessages(): ChatMessage[*]
    +clearHistory(): void
    +countMessages(): Integer
}

class ChatMessage <<TRANSIENT>> #FCE4EC {
    +role: ChatRole
    +content: String
}

'======================
' Relationships
'======================
Candidate "*" --> "1" JobPosting : applies_to
Candidate "*" --> "1" Requirements : evaluated_against
Candidate "1" --> "0..1" EvaluationResult : has_result
Candidate "1" --> "0..1" CVTemplate : uses

JobPosting "1" *-- "1" Requirements : contains
Requirements "0..1" *-- "0..1" EvaluationConfig : configures
Requirements "0..*" --> "0..*" Skill : references
Requirements "0..*" --> "0..*" Department : references

HRUser "1" --> "0..*" JobPosting : manages
HRUser "1" --> "0..*" Candidate : reviews
HRUser ..> AnalyticsSnapshot : views
HRUser ..> BulkStatusCommand : issues
BulkStatusCommand ..> Candidate : updates_status

AnalyticsSnapshot ..> Candidate : aggregates
AnalyticsSnapshot ..> JobPosting : aggregates

Visitor ..> JobPosting : browses
Visitor ..> Candidate : submits
Visitor ..> VerificationStore : tracks_via_email
Visitor ..> JobRecommendation : requests
Visitor ..> ChatSession : initiates

VerificationStore ..> EmailService : sends_code_via
VerificationStore ..> Candidate : tracks_email

ChatSession "1" *-- "1..*" ChatMessage : contains

AIProcessor ..> Candidate : processes
AIProcessor ..> EvaluationResult : produces
AIProcessor ..> JobRecommendation : produces
AIProcessor ..> ChatSession : responds_to
AIProcessor ..> EmailService : notifies_via
AIProcessor ..> CVTemplate : renders_with

JobRecommendation "*" --> "1" JobPosting : targets

@enduml
