@startuml Sprint2_EmailVerification_TrackingCode_Sequence
!theme plain
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200

title Sprint 2: Email Verification & Application Tracking - MVC Sequence

actor "Candidate" as Candidate
participant "TrackingComponent\n(View)" as View
participant "CandidateController\n(Controller)" as Controller
database "Candidate\n(Model)" as CandidateModel

== **Request Verification Code** ==

Candidate -> View: Enter email address\nClick "Send Tracking Code"
activate View

View -> Controller: POST /api/candidates/track/request-code\n{email: "john@example.com"}
activate Controller

Controller -> CandidateModel: SELECT * FROM candidates\nWHERE email = 'john@example.com'
activate CandidateModel
CandidateModel -> Controller: [{id: 1, documentId: "cand_abc"}, {id: 2, documentId: "cand_def"}]\n(Multiple applications per email)
deactivate CandidateModel

Controller -> Controller: Generate 6-digit code\ncode = "123456"\nHash = SHA256(email:code:secret)\nExpires in: 15 minutes

Controller -> CandidateModel: UPDATE candidates SET\ntrackingCodeHash = hash,\ntrackingCodeExpiresAt = NOW() + 15 min\nWHERE email = 'john@example.com'\n(Updates ALL matching candidates)
activate CandidateModel
CandidateModel -> Controller: Updated 2 candidates
deactivate CandidateModel

Controller -> Controller: Send SMTP email\nSubject: "Your Tracking Code"\nBody: "Code: 123456\nExpires: 15 min"

alt email send fails
    Controller -> View: HTTP 500\n{error: "Unable to send email"}
    View -> Candidate: Show error
    stop
else email sent success
    Controller -> View: HTTP 200\n{message: "If this email has applications,\na verification code has been sent"}
    note right of Controller
        Generic message to avoid leaking\nwhether email exists (privacy)
    end note
end
deactivate Controller

View -> Candidate: Show code input form\nDisplay 15-minute countdown timer
deactivate View

== **Verify Code & List Applications** ==

Candidate -> View: Enter code "123456"\nClick "View Applications"
activate View

View -> Controller: POST /api/candidates/track/verify-code\n{email: "john@example.com", code: "123456"}
activate Controller

Controller -> Controller: Hash code: SHA256(email:code:secret)

Controller -> CandidateModel: SELECT * FROM candidates\nWHERE email = 'john@example.com'\nAND trackingCodeHash = hash\nAND trackingCodeExpiresAt >= NOW()\n(Must be valid AND not expired)
activate CandidateModel

alt code valid & not expired
    CandidateModel -> Controller: [{id: 1, score: 82, job: "React Dev"},\n{id: 2, score: 45, job: "DevOps"}]
    
else code invalid OR expired
    CandidateModel -> Controller: No match
    Controller -> View: HTTP 400\n{error: "Invalid or expired code"}
    View -> Candidate: Show error\nOffer resend option
    stop
end
deactivate CandidateModel

Controller -> Controller: Clear tracking fields\n(One-time code - no reuse)\ntrackingCodeHash = NULL\ntrackingCodeExpiresAt = NULL\nUPDATE all matching candidates

Controller -> View: HTTP 200\n{email: "john@example.com",\napplications: [\n  {documentId: "cand_abc", status: "reviewing",\n   score: 82, qualityLabel: "good",\n   jobTitle: "React Dev", createdAt: "..."},\n  {documentId: "cand_def", status: "new",\n   score: 45, qualityLabel: "fair",\n   jobTitle: "DevOps", createdAt: "..."}\n]}
deactivate Controller

View -> Candidate: Display all applications for this email\nShow score, status, job title for each\nOffer download CV / withdraw options
deactivate View

@enduml
