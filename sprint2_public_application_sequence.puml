@startuml Sprint2_CreateJobPosting_Sequence
!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontColor black
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam padding 10

title Sprint 1: Create Job Posting - MVC Sequence\nAuthenticated HR User

actor "HR User" as HR
participant "JobPostingsComponent\n(View)" as View
participant "JobPostingController\n(Controller)" as Controller
participant "DepartmentController\n(Controller)" as DeptController
participant "SkillController\n(Controller)" as SkillController
database "JobPosting\n(Model)" as JobModel
database "Department\n(Model)" as DeptModel
database "Skill\n(Model)" as SkillModel

== **AUTH (Referenced Flow)** ==

group #F0F0F0 AUTH
    HR -> HR: Verify JWT Token\n& role=hr_manager
    activate HR
    note right: See: Sprint1_Authentication_Sequence
    deactivate HR
end

== **Create Job Posting Flow** ==

HR -> View: Fill form (title, desc, skills, dept)\nClick Submit
activate View

View -> Controller: POST /api/job-postings\nAuth: Bearer {jwt}\n{payload}
activate Controller

Controller -> Controller: Validate JWT & role

Controller -> Controller: Validate required fields
alt validation fails
    Controller --> View: HTTP 400 {error: "Invalid fields"}
    View --> HR: Show validation errors
else validation success
    Controller -> SkillController: Resolve skills ["React", "TS"]
    activate SkillController

    SkillController -> SkillModel: SELECT id FROM skills
    activate SkillModel

    alt skills not found
        SkillModel --> SkillController: Missing skills
        SkillController --> Controller: Not found
        Controller --> View: HTTP 400 {error: "Skill not found"}
        View --> HR: Show error
    else skills found
        SkillModel --> SkillController: {ids: [12, 18]}
        deactivate SkillModel
        SkillController --> Controller: {ids: [12, 18]}
        deactivate SkillController

        Controller -> DeptController: Resolve department "Engineering"
        activate DeptController

        DeptController -> DeptModel: SELECT id FROM departments
        activate DeptModel

        alt department not found
            DeptModel --> DeptController: No result
            DeptController --> Controller: Not found
            Controller --> View: HTTP 400 {error: "Dept not found"}
            View --> HR: Show error
        else department found
            DeptModel --> DeptController: {id: 5}
            deactivate DeptModel
            DeptController --> Controller: {id: 5}
            deactivate DeptController

            Controller -> JobModel: INSERT INTO job_postings\n(values...)
            activate JobModel

            JobModel --> Controller: {id: 42, status: "open"}
            deactivate JobModel

            Controller --> View: HTTP 201 Created\n{Job Object + publicLink}
            deactivate Controller

            View -> View: Update UI state\nRedirect to preview
            View --> HR: ✅ Job posted successfully!
        end
    end
end
deactivate View

@enduml