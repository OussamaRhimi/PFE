@startuml Sprint3_ResumeTextExtraction_Parsing_Sequence
!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontColor black
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam padding 10

title Sprint 3: Resume Processing Pipeline - MVC Sequence\nHR Triggers AI Processing

actor "HR User" as HR
participant "CandidateComponent\n(View)" as View
participant "CandidateController\n(Controller)" as Controller
participant "CVTemplateController\n(Controller)" as TemplateController
participant "AI Pipeline\n(Secondary)" as AI
database "Candidate\n(Model)" as CandidateModel
database "CVTemplate\n(Model)" as TemplateModel

== **AUTH (Referenced Flow)** ==

group #F0F0F0 AUTH
    HR -> HR: Verify JWT Token\n& role=hr_manager
    activate HR
    note right: See: Sprint1_Authentication_Sequence
    deactivate HR
end

== **Resume Processing Pipeline** ==

HR -> View: Click "Process Resume"\nfor candidate id=99
activate View

View -> Controller: POST /api/candidates/:id/process\nHeaders: Authorization: Bearer {jwt_token}\n{id: 99}
activate Controller

Controller -> Controller: Validate JWT & role

Controller -> CandidateModel: SELECT id, resume_id, job_posting, status\nFROM candidates WHERE id = 99
activate CandidateModel

alt candidate not found
    CandidateModel -> Controller: No result
    deactivate CandidateModel
    Controller -> View: HTTP 404
    deactivate Controller
    View -> HR: Show error
    stop
end

CandidateModel -> Controller: {id: 99, resume_id: 42, status: "new"}
deactivate CandidateModel

Controller -> Controller: Validate status transition\nMust be "new" or "error"
alt invalid status
    Controller -> View: HTTP 400\n{error: "Cannot process in current status"}
    deactivate Controller
    View -> HR: Show error
    stop
end

Controller -> View: HTTP 202 Accepted\n{message: "Processing started"}
deactivate Controller

View -> HR: Show "Processing..." indicator
deactivate View

Controller -> AI: 🔄 processCandidate(id=99)\nAsynchronous background job
activate AI

AI -> AI: 1. Load candidate & resume file
AI -> TemplateController: Load CV template
activate TemplateController
TemplateController -> TemplateModel: SELECT structure, css_styles FROM cv_templates\nWHERE is_default = true
activate TemplateModel
TemplateModel -> TemplateController: {structure, css_styles}
deactivate TemplateModel
TemplateController -> AI: Template data
deactivate TemplateController

AI -> AI: 2. Extract text from resume\n(pdf-parse/mammoth/txt)
AI -> AI: 3. Call Ollama AI (parse content)\nTimeout: 120s
alt Ollama fails
    AI -> CandidateModel: UPDATE candidates\nSET status = 'error'
    deactivate AI
    stop
end

AI -> AI: 4. Parse JSON response\n5. Evaluate score & label\n6. Generate standardized CV

AI -> CandidateModel: UPDATE candidates\nSET status = 'processed',\nextractedData = {...},\nscore = 82.5,\nqualityLabel = 'good',\nstandardizedCvMarkdown = '...'
activate CandidateModel
CandidateModel -> AI: Update successful
deactivate CandidateModel
deactivate AI

@enduml
